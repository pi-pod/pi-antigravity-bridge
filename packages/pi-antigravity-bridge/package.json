{
  "name": "@pipod/pi-antigravity-bridge",
  "version": "1.10.6",
  "description": "Pi and pipod provider through the official Antigravity CLI, with ACP streaming, client-owned sign-in and a Pi MCP tool bridge.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "antigravity-acp",
    "agy",
    "gemini",
    "google",
    "google-acp",
    "acp",
    "agent-client-protocol",
    "mcp",
    "mcp-server",
    "provider",
    "streaming"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@attitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-pod/pi-antigravity-bridge.git",
    "directory": "packages/pi-antigravity-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "pipod": {
    "clientExtensions": ["./src/client-extension.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@estebanforge/pi-ask-shared": "^0.1.6",
    "@estebanforge/pi-tui-dialogs": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0"
  }
}
